  <div id="mySidenav" class="sidenav">
    <a href="/" class="sideNavbar-title">HotHeel&</a>
    <a href="javascript:void(0)" class="closebtn sideNavbar" onclick="closeNav()">&times;</a>
    span#sideNavgap
    <a href="#" class="sideNavbar-sub ">About</a>
    <a href="#" class="sideNavbar-sub">Services</a>
    <a href="#" class="sideNavbar-sub">Clients</a>
    <a href="#" class="sideNavbar-sub">Contact</a>
  </div>
  .menu__logo( onclick="openNav()")
    img(src='/img/menu-2.png' alt='logo')
  .header__logo 
    img(src='/img/icon-new.png' alt='logo')
  nav.nav.nav--tours
    a.nav__el-hero(href='/') HotHeel&
  nav.nav.nav--user
    if user
      a.nav__el.nav__el--logout Log out
      a.nav__el(href='/me')
        img.nav__user-img(src=`/img/users/${user.photo}` alt=`Photo of ${user.name}`)
        span= user.name.split(' ')[0]
    else
      a.nav__el(href='/login') Log in
      a.nav__el.nav__el--cta(href='#') Sign up
