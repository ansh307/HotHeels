    // FOOTER
    include _footer
    
    script(src='/js/carousel.js')
    script(src='/js/sideNavbar.js')
    //- script(src='/js/stickyNavbar.js')

    <script>history.scrollRestoration = "manual"</script>
    <script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script> 